<?xml version="1.0"?>
<?mso-application progid="Excel.Sheet"?>
<Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet"
 xmlns:o="urn:schemas-microsoft-com:office:office"
 xmlns:x="urn:schemas-microsoft-com:office:excel"
 xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet"
 xmlns:html="http://www.w3.org/TR/REC-html40">
 <DocumentProperties xmlns="urn:schemas-microsoft-com:office:office">
  <Author>Senior QA Automation Engineer</Author>
  <Title>Danh Sách Test Cases Đăng Nhập UTC</Title>
 </DocumentProperties>
 <Styles>
  <Style ss:ID="Default" ss:Name="Normal">
   <Alignment ss:Vertical="Center"/>
   <Borders/>
   <Font ss:FontName="Calibri" ss:Size="11" ss:Color="#000000"/>
   <Interior/>
   <NumberFormat/>
   <Protection/>
  </Style>
  <Style ss:ID="TitleStyle">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
   <Font ss:FontName="Calibri" ss:Size="16" ss:Bold="1" ss:Color="#1F4E78"/>
   <Interior ss:Color="#D9E1F2" ss:Pattern="Solid"/>
  </Style>
  <Style ss:ID="HeaderStyle">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center" ss:WrapText="1"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#000000"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#000000"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#000000"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#000000"/>
   </Borders>
   <Font ss:FontName="Calibri" ss:Size="11" ss:Bold="1" ss:Color="#FFFFFF"/>
   <Interior ss:Color="#1F4E78" ss:Pattern="Solid"/>
  </Style>
  <Style ss:ID="DataStyle">
   <Alignment ss:Vertical="Top" ss:WrapText="1"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
   </Borders>
   <Font ss:FontName="Calibri" ss:Size="10" ss:Color="#000000"/>
  </Style>
  <Style ss:ID="DataCenter">
   <Alignment ss:Horizontal="Center" ss:Vertical="Top" ss:WrapText="1"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
   </Borders>
   <Font ss:FontName="Calibri" ss:Size="10" ss:Bold="1" ss:Color="#000000"/>
  </Style>
  <Style ss:ID="StatusPass">
   <Alignment ss:Horizontal="Center" ss:Vertical="Top"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
   </Borders>
   <Font ss:FontName="Calibri" ss:Size="10" ss:Bold="1" ss:Color="#276A3C"/>
   <Interior ss:Color="#E2EFDA" ss:Pattern="Solid"/>
  </Style>
  <Style ss:ID="StatusSkip">
   <Alignment ss:Horizontal="Center" ss:Vertical="Top"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
   </Borders>
   <Font ss:FontName="Calibri" ss:Size="10" ss:Bold="1" ss:Color="#7F6000"/>
   <Interior ss:Color="#FFF2CC" ss:Pattern="Solid"/>
  </Style>
  <Style ss:ID="StatusXFail">
   <Alignment ss:Horizontal="Center" ss:Vertical="Top"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
   </Borders>
   <Font ss:FontName="Calibri" ss:Size="10" ss:Bold="1" ss:Color="#C00000"/>
   <Interior ss:Color="#FCE4D6" ss:Pattern="Solid"/>
  </Style>
 </Styles>
 <Worksheet ss:Name="TestCases_Login">
  <Table ss:DefaultRowHeight="20">
   <Column ss:Width="40"/>
   <Column ss:Width="70"/>
   <Column ss:Width="110"/>
   <Column ss:Width="230"/>
   <Column ss:Width="240"/>
   <Column ss:Width="150"/>
   <Column ss:Width="240"/>
   <Column ss:Width="90"/>
   <Column ss:Width="90"/>

   <!-- Title Row -->
   <Row ss:Height="35">
    <Cell ss:MergeAcross="8" ss:StyleID="TitleStyle">
     <Data ss:Type="String">BẢNG DANH SÁCH TEST CASES KIỂM THỬ ĐĂNG NHẬP (TC1 - TC20) - VĂN PHÒNG ĐIỆN TỬ UTC</Data>
    </Cell>
   </Row>

   <!-- Header Row -->
   <Row ss:Height="28">
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">STT</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Mã TC</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Nhóm Test</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Mô tả Test Case (Description)</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Các bước thực hiện (Steps)</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Dữ liệu kiểm thử (Test Data)</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Kết quả mong đợi (Expected Output)</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Phân loại</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Trạng thái</Data></Cell>
   </Row>

   <!-- TC1 -->
   <Row ss:Height="45">
    <Cell ss:StyleID="DataCenter"><Data ss:Type="Number">1</Data></Cell>
    <Cell ss:StyleID="DataCenter"><Data ss:Type="String">TC1</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">Đăng nhập</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">Đăng nhập thành công với tài khoản hợp lệ</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">1. Mở trang Login&#10;2. Nhập username hợp lệ&#10;3. Nhập password hợp lệ&#10;4. Click nút Đăng nhập</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">test_user_placeholder / test_password_placeholder</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">Đăng nhập thành công, thoát khỏi trang /Login</Data></Cell>
    <Cell ss:StyleID="DataCenter"><Data ss:Type="String">Positive</Data></Cell>
    <Cell ss:StyleID="StatusSkip"><Data ss:Type="String">SKIPPED</Data></Cell>
   </Row>

   <!-- TC2 -->
   <Row ss:Height="45">
    <Cell ss:StyleID="DataCenter"><Data ss:Type="Number">2</Data></Cell>
    <Cell ss:StyleID="DataCenter"><Data ss:Type="String">TC2</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">Đăng nhập</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">Để trống ô Username</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">1. Mở trang Login&#10;2. Để trống ô Username&#10;3. Nhập password hợp lệ&#10;4. Click nút Đăng nhập</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">[Trống] / test_password_placeholder</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">Hệ thống chặn gửi form hoặc ở lại trang Login</Data></Cell>
    <Cell ss:StyleID="DataCenter"><Data ss:Type="String">Negative</Data></Cell>
    <Cell ss:StyleID="StatusPass"><Data ss:Type="String">PASSED</Data></Cell>
   </Row>

   <!-- TC3 -->
   <Row ss:Height="45">
    <Cell ss:StyleID="DataCenter"><Data ss:Type="Number">3</Data></Cell>
    <Cell ss:StyleID="DataCenter"><Data ss:Type="String">TC3</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">Đăng nhập</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">Để trống ô Password</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">1. Mở trang Login&#10;2. Nhập username hợp lệ&#10;3. Để trống ô Password&#10;4. Click nút Đăng nhập</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">test_user_placeholder / [Trống]</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">Hệ thống chặn gửi form hoặc ở lại trang Login</Data></Cell>
    <Cell ss:StyleID="DataCenter"><Data ss:Type="String">Negative</Data></Cell>
    <Cell ss:StyleID="StatusPass"><Data ss:Type="String">PASSED</Data></Cell>
   </Row>

   <!-- TC4 -->
   <Row ss:Height="45">
    <Cell ss:StyleID="DataCenter"><Data ss:Type="Number">4</Data></Cell>
    <Cell ss:StyleID="DataCenter"><Data ss:Type="String">TC4</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">Giao diện (UI)</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">Kiểm tra placeholder khi để trống cả hai trường</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">1. Mở trang Login&#10;2. Quan sát ô Username và Password</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">Không có</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">Hiển thị đúng placeholder 'Tên đăng nhập' và 'Mật khẩu'</Data></Cell>
    <Cell ss:StyleID="DataCenter"><Data ss:Type="String">UI</Data></Cell>
    <Cell ss:StyleID="StatusPass"><Data ss:Type="String">PASSED</Data></Cell>
   </Row>

   <!-- TC5 -->
   <Row ss:Height="45">
    <Cell ss:StyleID="DataCenter"><Data ss:Type="Number">5</Data></Cell>
    <Cell ss:StyleID="DataCenter"><Data ss:Type="String">TC5</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">Đăng nhập</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">Đăng nhập với mật khẩu không đúng</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">1. Mở trang Login&#10;2. Nhập username hợp lệ&#10;3. Nhập password sai&#10;4. Click nút Đăng nhập</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">test_user_placeholder / WrongPass!999</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">Hiển thị thông báo: 'Tài khoản hoặc mật khẩu không đúng.'</Data></Cell>
    <Cell ss:StyleID="DataCenter"><Data ss:Type="String">Negative</Data></Cell>
    <Cell ss:StyleID="StatusPass"><Data ss:Type="String">PASSED</Data></Cell>
   </Row>

   <!-- TC6 -->
   <Row ss:Height="45">
    <Cell ss:StyleID="DataCenter"><Data ss:Type="Number">6</Data></Cell>
    <Cell ss:StyleID="DataCenter"><Data ss:Type="String">TC6</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">Đăng nhập</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">Đăng nhập với tên tài khoản không tồn tại</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">1. Mở trang Login&#10;2. Nhập username sai&#10;3. Nhập mật khẩu bất kỳ&#10;4. Click nút Đăng nhập</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">wrong_user_xyz / test_password_placeholder</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">Hiển thị thông báo lỗi và từ chối đăng nhập</Data></Cell>
    <Cell ss:StyleID="DataCenter"><Data ss:Type="String">Negative</Data></Cell>
    <Cell ss:StyleID="StatusPass"><Data ss:Type="String">PASSED</Data></Cell>
   </Row>

   <!-- TC7 -->
   <Row ss:Height="45">
    <Cell ss:StyleID="DataCenter"><Data ss:Type="Number">7</Data></Cell>
    <Cell ss:StyleID="DataCenter"><Data ss:Type="String">TC7</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">Đăng nhập</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">Để trống cả Username và Password (click Login trực tiếp)</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">1. Mở trang Login&#10;2. Để trống cả 2 ô&#10;3. Click nút Đăng nhập</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">[Trống] / [Trống]</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">Hệ thống chặn gửi form hoặc ở lại trang Login</Data></Cell>
    <Cell ss:StyleID="DataCenter"><Data ss:Type="String">Negative</Data></Cell>
    <Cell ss:StyleID="StatusPass"><Data ss:Type="String">PASSED</Data></Cell>
   </Row>

   <!-- TC8 -->
   <Row ss:Height="45">
    <Cell ss:StyleID="DataCenter"><Data ss:Type="Number">8</Data></Cell>
    <Cell ss:StyleID="DataCenter"><Data ss:Type="String">TC8</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">OAuth</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">Đăng nhập bằng nút 'Đăng nhập bằng e-mail UTC'</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">1. Mở trang Login&#10;2. Click nút 'Đăng nhập bằng e-mail UTC'</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">Không có</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">Chuyển hướng sang Google OAuth (accounts.google.com)</Data></Cell>
    <Cell ss:StyleID="DataCenter"><Data ss:Type="String">Integration</Data></Cell>
    <Cell ss:StyleID="StatusPass"><Data ss:Type="String">PASSED</Data></Cell>
   </Row>

   <!-- TC9 -->
   <Row ss:Height="45">
    <Cell ss:StyleID="DataCenter"><Data ss:Type="Number">9</Data></Cell>
    <Cell ss:StyleID="DataCenter"><Data ss:Type="String">TC9</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">Chức năng</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">Kiểm tra liên kết 'Bạn quên mật khẩu đăng nhập ?'</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">1. Mở trang Login&#10;2. Click link 'Bạn quên mật khẩu đăng nhập ?'</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">Không có</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">Chuyển hướng đến trang /Login/GetPass</Data></Cell>
    <Cell ss:StyleID="DataCenter"><Data ss:Type="String">Functional</Data></Cell>
    <Cell ss:StyleID="StatusPass"><Data ss:Type="String">PASSED</Data></Cell>
   </Row>

   <!-- TC10 -->
   <Row ss:Height="45">
    <Cell ss:StyleID="DataCenter"><Data ss:Type="Number">10</Data></Cell>
    <Cell ss:StyleID="DataCenter"><Data ss:Type="String">TC10</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">Đăng nhập</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">Sử dụng phím Enter để đăng nhập</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">1. Mở trang Login&#10;2. Nhập user và pass hợp lệ&#10;3. Nhấn Enter trên bàn phím</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">test_user_placeholder / test_password_placeholder</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">Form submit và đăng nhập thành công vào hệ thống</Data></Cell>
    <Cell ss:StyleID="DataCenter"><Data ss:Type="String">Positive</Data></Cell>
    <Cell ss:StyleID="StatusSkip"><Data ss:Type="String">SKIPPED</Data></Cell>
   </Row>

   <!-- TC11 -->
   <Row ss:Height="45">
    <Cell ss:StyleID="DataCenter"><Data ss:Type="Number">11</Data></Cell>
    <Cell ss:StyleID="DataCenter"><Data ss:Type="String">TC11</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">Dữ liệu</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">Tên đăng nhập có chứa khoảng trắng ở đầu/cuối</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">1. Mở trang Login&#10;2. Nhập username có khoảng trắng&#10;3. Nhập password hợp lệ&#10;4. Click Đăng nhập</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">' test_user_placeholder ' / test_password_placeholder</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">Hệ thống tự động trim hoặc báo lỗi an toàn</Data></Cell>
    <Cell ss:StyleID="DataCenter"><Data ss:Type="String">Boundary</Data></Cell>
    <Cell ss:StyleID="StatusPass"><Data ss:Type="String">PASSED</Data></Cell>
   </Row>

   <!-- TC12 -->
   <Row ss:Height="45">
    <Cell ss:StyleID="DataCenter"><Data ss:Type="Number">12</Data></Cell>
    <Cell ss:StyleID="DataCenter"><Data ss:Type="String">TC12</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">Bảo mật</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">Mật khẩu có phân biệt chữ hoa, chữ thường</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">1. Mở trang Login&#10;2. Nhập user hợp lệ&#10;3. Nhập pass sai hoa thường&#10;4. Click Đăng nhập</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">test_user_placeholder / test_wrong_case_password</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">Hệ thống phân biệt hoa/thường và từ chối đăng nhập</Data></Cell>
    <Cell ss:StyleID="DataCenter"><Data ss:Type="String">Security</Data></Cell>
    <Cell ss:StyleID="StatusPass"><Data ss:Type="String">PASSED</Data></Cell>
   </Row>

   <!-- TC13 -->
   <Row ss:Height="45">
    <Cell ss:StyleID="DataCenter"><Data ss:Type="Number">13</Data></Cell>
    <Cell ss:StyleID="DataCenter"><Data ss:Type="String">TC13</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">Bảo mật</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">Chống tấn công SQL Injection vào Username/Password</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">1. Mở trang Login&#10;2. Nhập payload SQL Injection&#10;3. Click nút Đăng nhập</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">' OR '1'='1 -- | admin'--</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">Hệ thống ngăn chặn cuộc tấn công, không rò rỉ dữ liệu</Data></Cell>
    <Cell ss:StyleID="DataCenter"><Data ss:Type="String">Security</Data></Cell>
    <Cell ss:StyleID="StatusPass"><Data ss:Type="String">PASSED</Data></Cell>
   </Row>

   <!-- TC14 -->
   <Row ss:Height="45">
    <Cell ss:StyleID="DataCenter"><Data ss:Type="Number">14</Data></Cell>
    <Cell ss:StyleID="DataCenter"><Data ss:Type="String">TC14</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">Biên giới hạn</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">Kiểm tra giới hạn độ dài ký tự quá lớn (255+ ký tự)</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">1. Mở trang Login&#10;2. Nhập 300+ ký tự vào ô Username/Password&#10;3. Click Đăng nhập</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">Chuỗi 300 ký tự 'A'</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">Hệ thống xử lý an toàn, không treo hoặc vỡ giao diện</Data></Cell>
    <Cell ss:StyleID="DataCenter"><Data ss:Type="String">Boundary</Data></Cell>
    <Cell ss:StyleID="StatusPass"><Data ss:Type="String">PASSED</Data></Cell>
   </Row>

   <!-- TC15 -->
   <Row ss:Height="45">
    <Cell ss:StyleID="DataCenter"><Data ss:Type="Number">15</Data></Cell>
    <Cell ss:StyleID="DataCenter"><Data ss:Type="String">TC15</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">Tiện ích</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">Copy-paste mật khẩu vào ô Password</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">1. Mở trang Login&#10;2. Nhập user hợp lệ&#10;3. Dán password vào ô Password&#10;4. Click Đăng nhập</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">test_user_placeholder / test_password_placeholder</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">Dán thành công và đăng nhập vào hệ thống</Data></Cell>
    <Cell ss:StyleID="DataCenter"><Data ss:Type="String">Functional</Data></Cell>
    <Cell ss:StyleID="StatusSkip"><Data ss:Type="String">SKIPPED</Data></Cell>
   </Row>

   <!-- TC16 -->
   <Row ss:Height="45">
    <Cell ss:StyleID="DataCenter"><Data ss:Type="Number">16</Data></Cell>
    <Cell ss:StyleID="DataCenter"><Data ss:Type="String">TC16</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">Bảo mật</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">Đăng nhập sai nhiều lần liên tiếp (Brute force protection)</Data></Cell>
    <Cell ss:StyleID="DataStyle"><Data ss:Type="String">1. Mở trang Login&#10;2. Nhập sai password liên tiếp 6 lần</Data></Cell>
